{
  "appId": "com.fbply.app",
  "appName": "FBPly",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "backgroundColor": "#0B1020",
    "allowMixedContent": false,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1400,
      "backgroundColor": "#0B1020",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    }
  }
}
